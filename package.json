{
  "name": "cardwright",
  "version": "1.3.0",
  "description": "Standalone Character Card V2 editor with LM Studio AI editing, lorebook support, audit tools, and PNG export.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberdeliaAI/Cardwright.git"
  },
  "keywords": [
    "character-card",
    "character-card-v2",
    "sillytavern",
    "lm-studio",
    "local-ai",
    "roleplay",
    "lorebook",
    "png-metadata"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test data-preservation.test.mjs server-security.test.mjs placeholders.test.mjs electron/tests/*.test.cjs",
    "desktop": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "test:desktop": "node --test electron/tests/*.test.cjs",
    "smoke:desktop": "node tools/smoke-electron.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "productName": "Cardwright",
  "author": "Cyberdelia",
  "main": "electron/main.cjs",
  "build": {
    "appId": "nl.cyberdelia.cardwright",
    "productName": "Cardwright",
    "executableName": "Cardwright",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/*.cjs",
      "server.mjs",
      "app.js",
      "index.html",
      "styles.css",
      "audit.js",
      "token-utils.js",
      "png.js",
      "cropper.js",
      "version.js",
      "placeholders.js",
      "package.json",
      "LICENSE",
      "assets/cardwright-icon.png",
      "assets/cardwright.ico",
      "assets/cardwright-icon-1024.png"
    ],
    "afterPack": "electron/harden.cjs",
    "artifactName": "cardwright-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "icon": "assets/cardwright.icns",
      "identity": "-"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/cardwright.ico"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "icon": "assets/cardwright-icon-1024.png",
      "category": "Utility"
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
